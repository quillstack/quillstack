#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Providers\CommandProvider;
use App\Providers\EntityRegistry;
use App\Providers\ServiceProviderRegistry;
use Quillstack\Cli\CommandProviderInterface;
use Quillstack\Framework\Console;
use Quillstack\Framework\Database\EntityRegistryInterface;
use Quillstack\Framework\Providers\ServiceProviderRegistryInterface;

require __DIR__ . '/../vendor/autoload.php';

$console = new Console(__DIR__ . '/../.env', [
    CommandProviderInterface::class => CommandProvider::class,
    ServiceProviderRegistryInterface::class => ServiceProviderRegistry::class,
    EntityRegistryInterface::class => EntityRegistry::class,
]);

exit($console->run($argv));
