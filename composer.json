{
    "name": "quillstack/quillstack",
    "description": "A project built based on the Quillstack Framework.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "quillstack",
        "framework",
        "skeleton",
        "api",
        "php8"
    ],
    "homepage": "https://quillstack.org/",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "quillstack/framework": "^0.5"
    },
    "require-dev": {
        "quillstack/unit-tests": "^0.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/quill"
    ],
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "serve": "php -S localhost:8000 -t public",
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr ./vendor/bin/unit-tests"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
